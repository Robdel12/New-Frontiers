---
import BaseLayout from '../layouts/BaseLayout.astro'

let apps = [
  {
    name: 'Vizzly',
    url: 'https://vizzly.dev',
    label: 'Developer Tools',
    description:
      'Visual regression testing built for speed and developer experience. Capture real screenshots from your tests, review UI changes with your team, and catch visual bugs before they ship.',
  },
  {
    name: 'OrbitDock',
    url: 'https://orbitdock.dev',
    label: 'AI Workflow',
    description:
      'Mission control for AI coding agents across macOS and iOS. Monitor Claude Code and Codex sessions, review work in progress, and keep agent-heavy development organized.',
  },
  {
    name: 'Tornadic',
    url: 'https://tornadic.net',
    label: 'Weather Data',
    description:
      'A tornado history, mapping, and evidence platform that brings official records, DAT surveys, radar, photos, and community contributions into one place.',
  },
  {
    name: 'MoonBun',
    url: 'https://moonbun.app',
    label: 'iOS App',
    description:
      'Care management for pet rabbits, built around the real daily handoff: feeding, medications, grooming, weight, health notes, reminders, and boarding care.',
  },
  {
    name: 'Snoot',
    url: 'https://snoot.support',
    label: 'Customer Support',
    description:
      'Real-time customer chat built with Phoenix LiveView. A fast embeddable widget, team inbox, and conversation management for support teams.',
  },
]
---

<BaseLayout
  title="Apps"
  description="Software and apps built by Robert DeLuca, including Vizzly, OrbitDock, Tornadic, MoonBun, and Snoot."
>
  <h1>Rob The Builder</h1>
  <p class="apps-intro">
    A living shelf of the products and apps I'm actively building.
  </p>

  <div class="apps-list">
    {
      apps.map((app) => (
        <article class="app-card">
          <div class="app-label">{app.label}</div>
          <h2>
            <a href={app.url} target="_blank" rel="noopener">
              {app.name}
            </a>
          </h2>
          <p>{app.description}</p>
        </article>
      ))
    }
  </div>

  <p class="more-software-note">
    Visit my
    <a href="https://github.com/Robdel12" target="_blank" rel="noopener"
      >GitHub</a
    >
    for more software I've written 👀
  </p>
</BaseLayout>
